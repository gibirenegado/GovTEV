{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated application user with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "encoder", "viewer"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "officeName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "Office": {
      "title": "Office",
      "description": "Government office, division, or unit.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 150 },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "headName": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceScope", "name", "code", "headName", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Registered government employee in the masterlist.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "employeeCode": { "type": "string", "minLength": 1, "maxLength": 50 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "officeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "officeName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "position": { "type": "string", "minLength": 2, "maxLength": 150 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceScope", "employeeCode", "fullName", "officeId", "officeName", "position", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "DocumentaryRequirement": {
      "title": "DocumentaryRequirement",
      "description": "Masterlist entry for TEV documentary requirements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 150 },
        "description": { "type": "string", "maxLength": 400 },
        "isDefault": { "type": "boolean" },
        "isCustom": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceScope", "code", "name", "description", "isDefault", "isCustom", "sortOrder", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "RequirementTemplate": {
      "title": "RequirementTemplate",
      "description": "Saved combination of applicable documentary requirements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 150 },
        "description": { "type": "string", "maxLength": 400 },
        "requirementIds": { "type": "array" },
        "requirementNames": { "type": "array" },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceScope", "name", "description", "requirementIds", "requirementNames", "createdBy", "createdAt", "updatedAt"]
    },
    "TravelRecord": {
      "title": "TravelRecord",
      "description": "Official travel and Travel Expense Voucher (TEV) transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "tevRefNumber": { "type": "string", "minLength": 3, "maxLength": 64 },
        "employeeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeCode": { "type": "string", "maxLength": 50 },
        "employeeName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "officeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "officeName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "position": { "type": "string", "maxLength": 150 },
        "destination": { "type": "string", "minLength": 2, "maxLength": 200 },
        "purpose": { "type": "string", "minLength": 2, "maxLength": 500 },
        "departureDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "returnDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "travelDays": { "type": "number" },
        "travelOrderNumber": { "type": "string", "maxLength": 80 },
        "travelOrderDate": { "type": "string", "maxLength": 10 },
        "submissionDate": { "type": "string", "maxLength": 10 },
        "processingOfficer": { "type": "string", "maxLength": 150 },
        "completionDate": { "type": "string", "maxLength": 10 },
        "remarks": { "type": "string", "maxLength": 1000 },
        "overallStatus": { "type": "string", "enum": ["Not Started", "In Progress", "For Submission", "For Signature", "For Approval", "Completed", "On Hold"] },
        "manualOnHold": { "type": "boolean" },
        "compliancePercentage": { "type": "number" },
        "applicableCount": { "type": "number" },
        "completedCount": { "type": "number" },
        "isSampleData": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceScope", "tevRefNumber", "employeeId", "employeeCode", "employeeName",
        "officeId", "officeName", "position", "destination", "purpose",
        "departureDate", "returnDate", "travelDays", "travelOrderNumber", "travelOrderDate",
        "submissionDate", "processingOfficer", "completionDate", "remarks",
        "overallStatus", "manualOnHold", "compliancePercentage", "applicableCount",
        "completedCount", "isSampleData", "createdBy", "createdByName", "createdAt", "updatedAt"
      ]
    },
    "TravelRequirementChecklist": {
      "title": "TravelRequirementChecklist",
      "description": "Independent documentary requirement checklist item for a specific TEV.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "tevId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tevRefNumber": { "type": "string", "minLength": 3, "maxLength": 64 },
        "requirementId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requirementName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "isCustom": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "applicable": { "type": "boolean" },
        "prepared": { "type": "boolean" },
        "submitted": { "type": "boolean" },
        "signed": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "returnedForCorrection": { "type": "boolean" },
        "datePrepared": { "type": "string", "maxLength": 10 },
        "dateSubmitted": { "type": "string", "maxLength": 10 },
        "dateSigned": { "type": "string", "maxLength": 10 },
        "dateApproved": { "type": "string", "maxLength": 10 },
        "signatoryName": { "type": "string", "maxLength": 150 },
        "approvingOfficerName": { "type": "string", "maxLength": 150 },
        "remarks": { "type": "string", "maxLength": 500 },
        "updatedBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedByName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceScope", "tevId", "tevRefNumber", "requirementId", "requirementName",
        "isCustom", "sortOrder", "applicable", "prepared", "submitted", "signed", "approved",
        "returnedForCorrection", "datePrepared", "dateSubmitted", "dateSigned", "dateApproved",
        "signatoryName", "approvingOfficerName", "remarks", "updatedBy", "updatedByName",
        "createdAt", "updatedAt"
      ]
    },
    "Attachment": {
      "title": "Attachment",
      "description": "Uploaded scanned copy or digital document tied to a TEV checklist item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "tevId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tevRefNumber": { "type": "string", "minLength": 3, "maxLength": 64 },
        "checklistItemId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requirementName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fileType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fileExtension": { "type": "string", "enum": ["pdf", "jpg", "jpeg", "png", "docx", "xlsx"] },
        "fileSize": { "type": "number" },
        "version": { "type": "number" },
        "isLatest": { "type": "boolean" },
        "dataUrl": { "type": "string", "maxLength": 900000 },
        "uploadedBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uploadedByName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceScope", "tevId", "tevRefNumber", "checklistItemId", "requirementName",
        "fileName", "fileType", "fileExtension", "fileSize", "version", "isLatest", "dataUrl",
        "uploadedBy", "uploadedByName", "createdAt", "updatedAt"
      ]
    },
    "ImportHistory": {
      "title": "ImportHistory",
      "description": "Audit log of bulk Excel import and update executions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mode": { "type": "string", "enum": ["import", "update"] },
        "totalRecords": { "type": "number" },
        "successCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "errorsSummary": { "type": "array" },
        "importedBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "importedByName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceScope", "fileName", "mode", "totalRecords", "successCount",
        "failedCount", "errorsSummary", "importedBy", "importedByName", "createdAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable system-wide audit trail for all TEV and masterlist operations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "action": { "type": "string", "minLength": 2, "maxLength": 100 },
        "entityType": { "type": "string", "minLength": 2, "maxLength": 60 },
        "entityId": { "type": "string", "maxLength": 128 },
        "entityLabel": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 600 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "maxLength": 150 },
        "userRole": { "type": "string", "enum": ["admin", "encoder", "viewer"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceScope", "action", "entityType", "entityId", "entityLabel",
        "details", "userId", "userName", "userRole", "createdAt"
      ]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global TEV monitoring thresholds, reference number format, and agency preferences.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceScope": { "type": "string", "enum": ["gov-tev-office"] },
        "agencyName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "agencySubtitle": { "type": "string", "maxLength": 200 },
        "tevRefPrefix": { "type": "string", "minLength": 2, "maxLength": 20 },
        "tevRefSeparator": { "type": "string", "minLength": 1, "maxLength": 5 },
        "overdueThresholdDays": { "type": "number" },
        "encoderCanImport": { "type": "boolean" },
        "defaultRequirementIds": { "type": "array" },
        "updatedBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceScope", "agencyName", "agencySubtitle", "tevRefPrefix",
        "tevRefSeparator", "overdueThresholdDays", "encoderCanImport",
        "defaultRequirementIds", "updatedBy", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication profiles and RBAC role assignments."
    },
    "/offices/{officeId}": {
      "schema": { "$ref": "#/entities/Office" },
      "description": "Masterlist of government offices, divisions, and units."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Registered government employee directory."
    },
    "/documentaryRequirements/{reqId}": {
      "schema": { "$ref": "#/entities/DocumentaryRequirement" },
      "description": "Masterlist of default and custom documentary requirements."
    },
    "/requirementTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/RequirementTemplate" },
      "description": "Saved reusable requirement checklist templates."
    },
    "/travelRecords/{tevId}": {
      "schema": { "$ref": "#/entities/TravelRecord" },
      "description": "Official travel records and TEV monitoring transactions."
    },
    "/travelRequirementChecklists/{checklistId}": {
      "schema": { "$ref": "#/entities/TravelRequirementChecklist" },
      "description": "Independent documentary requirement checklist rows per TEV."
    },
    "/attachments/{attachmentId}": {
      "schema": { "$ref": "#/entities/Attachment" },
      "description": "Digital document attachments linked to TEVs and checklist rows."
    },
    "/importHistory/{importId}": {
      "schema": { "$ref": "#/entities/ImportHistory" },
      "description": "Bulk Excel import and update execution history."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable system-wide audit trail."
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "System-wide configuration settings."
    }
  }
}
